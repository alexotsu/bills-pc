NEXT_PUBLIC_API_URL=http://localhost:8080

# Same host as the API's CARD_IMAGE_BASE_URL (see web/api/.env.example) — needed here too
# because the live game board renders card art straight from wasm state, without a round trip
# through the API. Leave unset to fall back to the plain name box everywhere.
# NEXT_PUBLIC_CARD_IMAGE_BASE_URL=https://cdn.example.com/cards
