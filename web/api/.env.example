DATABASE_URL=postgres://deckgym:deckgym_dev_password@localhost:5432/deckgym

# Base URL of the external host serving card art (e.g. an S3/R2 bucket or image CDN), no
# trailing slash. Leave unset to have every card's image_url come back null (frontend falls
# back to its plain name box). Expects "<base>/<id-with-hyphens>.png" per card, e.g.
# https://cdn.example.com/cards/A1-001.png — see card_image_url in src/cards.rs.
# CARD_IMAGE_BASE_URL=https://cdn.example.com/cards
